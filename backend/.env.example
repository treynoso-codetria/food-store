# Copiá este archivo a .env (cp .env.example .env). El .env NO se sube al repo.

# PostgreSQL del docker-compose.yml de la raíz (puerto 5433 para no chocar con otro Postgres local)
DATABASE_URL=postgresql+psycopg2://foodstore:foodstore@localhost:5433/foodstore_db
# Alternativa sin Docker (solo desarrollo):
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (varios separados por coma)
FRONTEND_ORIGIN=http://localhost:5173

# true solo detrás de HTTPS (producción)
COOKIE_SECURE=false
